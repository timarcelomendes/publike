# Copie este arquivo para .env.local e preencha.
# Sem as duas chaves do Supabase o site abre em "modo demonstração",
# com anúncios de exemplo e sem login.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (links, sitemap e volta do login com redes sociais)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formas de entrar. O e-mail (link mágico) já funciona sem configurar nada.
# Ligue as outras depois de ativá-las no Supabase (veja o README, parte 3).
NEXT_PUBLIC_LOGIN_GOOGLE=false
NEXT_PUBLIC_LOGIN_FACEBOOK=false
NEXT_PUBLIC_LOGIN_LINKEDIN=false
NEXT_PUBLIC_LOGIN_CELULAR=false

# Google: ID do cliente OAuth (Google Cloud > Google Auth Platform > Clientes).
# Com ele, a janela do Google mostra o Publike, não o endereço do Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Verificação contra robôs no pedido do link de acesso (Cloudflare Turnstile,
# grátis). Só a chave pública (site key) fica aqui; a secreta vai no Supabase.
# Veja o README, parte 3 ("Proteção contra robôs").
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional: e-mail de contato mostrado na página de privacidade
NEXT_PUBLIC_CONTATO_EMAIL=

# Opcional: estilo do mapa. Padrão: OpenFreeMap Positron (grátis, sem chave)
NEXT_PUBLIC_MAPA_ESTILO=https://tiles.openfreemap.org/styles/positron

# ---------------------------------------------------------------------
# Daqui para baixo, só o servidor lê (nada vai para o navegador).
# ---------------------------------------------------------------------

# Admin (README, parte 4.2). SÓ NO SEU COMPUTADOR, nunca na hospedagem.
# Supabase > Project Settings > API Keys > Secret keys
PUBLIKE_ADMIN=0
SUPABASE_SECRET_KEY=

# Chave do servidor, gerada no admin em "Chaves" (README, parte 4.4).
# Vai na hospedagem; no seu computador não precisa.
PUBLIKE_CHAVE_SERVIDOR=

# E-mails do site pelo Zoho CPaaS (README, parte 4.3).
# Usuário e senha ficam em Agents > publike > SMTP/API.
SMTP_SERVIDOR=smtp.zeptomail.com
SMTP_PORTA=465
SMTP_USUARIO=emailapikey
SMTP_SENHA=
# Quem aparece como remetente (precisa ser do domínio verificado no Zoho CPaaS)
SMTP_REMETENTE=nao-responda@publike.org
# Só no seu computador, quando o site estiver no ar: o endereço público
# usado nos links dos e-mails (sem ele, daqui só sai o e-mail de teste).
PUBLIKE_URL_PUBLICA=

# IA: chave da API da OpenAI (README, parte 4.5)
OPENAI_API_KEY=

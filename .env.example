# Copie este arquivo para .env.local e preencha.
# Sem as duas chaves do Supabase o site abre em "modo demonstração",
# com anúncios de exemplo e sem login.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (links, sitemap e volta do login com redes sociais)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formas de entrar. O e-mail (link mágico) já funciona sem configurar nada.
# Ligue as outras depois de ativá-las no Supabase (veja o README, parte 3).
NEXT_PUBLIC_LOGIN_GOOGLE=false
NEXT_PUBLIC_LOGIN_FACEBOOK=false
NEXT_PUBLIC_LOGIN_LINKEDIN=false
NEXT_PUBLIC_LOGIN_CELULAR=false

# Opcional: e-mail de contato mostrado na página de privacidade
NEXT_PUBLIC_CONTATO_EMAIL=

# Opcional: estilo do mapa. Padrão: OpenFreeMap Positron (grátis, sem chave)
NEXT_PUBLIC_MAPA_ESTILO=https://tiles.openfreemap.org/styles/positron
